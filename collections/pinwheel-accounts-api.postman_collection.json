        {
          "name": "List Accounts",
          "id": "14848135-e015-4e4c-868f-a9196a11cf3c",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "description": "(Required) Version identifier specifying how the Pinwheel API should behave. See the Change Management page for more information.",
                "key": "Pinwheel-Version",
                "value": "2025-07-08"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts?cursor=<string>&limit=25&connected=<boolean>&monitoring_status=user_action_required",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ],
              "query": [
                {
                  "description": "Cursor for the page you want to retrieve.",
                  "key": "cursor",
                  "value": "<string>"
                },
                {
                  "description": "The maximum number of results to return.",
                  "key": "limit",
                  "value": "25"
                },
                {
                  "description": "If included, filter on connected accounts. If true, return only accounts that are connected. If false, return only accounts that are disconnected. Connected accounts are accounts for which you can retrieve new data manually using On Demand Updates or automatically via Monitoring.",
                  "key": "connected",
                  "value": "<boolean>"
                },
                {
                  "description": "Monitoring status describes the the automated ability of Pinwheel to retrieve new account information.",
                  "key": "monitoring_status",
                  "value": "user_action_required"
                }
              ]
            },
            "description": "List all payroll accounts. This is a paginated endpoint; see how Pinwheel implements pagination here."
          },
