          "name": "List Tax Forms",
          "request": {
            "name": "List Tax Forms",
            "description": {
              "content": "Lists all tax forms associated with a payroll account. Each tax form contains metadata like year, form type, and form ID. Tax forms are returned in reverse chronological order by year. This is a paginated endpoint; see how Pinwheel implements pagination <a href='https://docs.pinwheelapi.com/docs/pagination-1' target='_blank'>here</a>.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "tax_forms"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from_year",
                  "value": "<integer>",
                  "description": "Filter for tax forms during or after this year."
                },
                {
                  "disabled": false,
                  "key": "to_year",
                  "value": "<integer>",
                  "description": "Filter for tax forms during or before this year."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor for the page you want to retrieve."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The maximum number of results to return."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "account_id",
                  "description": "(Required) UUID of the payroll account."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Version identifier specifying how the Pinwheel API should behave. See the Change Management page for more information.",
